                "value" : ".form-control {\n    padding-top: 0rem !important;\n    padding-bottom: 0rem !important;\n    font-size: 17px;\n}"
              },
              "customHTML" : {
                "value" : "\u003cdiv\n  class=\"bg-light d-flex flex-column justify-content-center align-items-center position-absolute top-0 start-0 bottom-0 end-0 overflow-auto\"\u003e\n  \u003cdiv style=\"max-width: 400px; min-width: 400px; width: 100%\"\u003e\n    \u003cdiv class=\"card shadow mb-5\"\u003e\n      \u003cdiv class=\"card-body p-5 d-flex flex-column\"\u003e\n        {{global.parameters.ciam_companyLogo}}\n        \u003ch1 id=\"header\" class=\"text-center mb-4\"\u003eVerification Code\u003c/h1\u003e\n        \u003cp class=\"text-muted text-center\"\u003e\n          Enter the code that was emailed to you to verify your email address.\n        \u003c/p\u003e\n        \u003cp id=\"feedback\" data-id=\"feedback\" class=\"text-danger mdi mdi-alert-circle text-center\" data-skcomponent=\"skerror\"\u003e\u003c/p\u003e\n        \u003cp id=\"verificationCodeFeedback\" data-id=\"verificationCodeFeedback\" class=\"text-danger mdi mdi-alert-circle text-center\"\n          data-skerrorid=\"verificationCode\" data-skcomponent=\"skerrormessage\"\u003e\u003c/p\u003e\n        \u003cform id=\"otpForm\" data-id=\"otpForm\"\u003e\n          \u003cdiv class=\"mb-4 form-floating\"\u003e\n            \u003cinput id=\"verificationCode\" data-id=\"verificationCode\" class=\"form-control text-center\" type=\"text\" name=\"verificationCode\"\n              placeholder=\"Verification Code\" autocomplete=\"off\" maxlength=\"8\" /\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"d-flex flex-column\"\u003e\n            \u003cbutton id=\"verifyBtn\" data-id=\"verifyBtn\" class=\"btn btn-primary mb-3\" type=\"submit\"\n              data-skcomponent=\"skbutton\" data-skbuttontype=\"form-submit\" data-skform=\"otpForm\" data-skbuttonvalue=\"VERIFY\"\u003e\n              Verify\n            \u003c/button\u003e\n            \u003cbutton type=\"submit\" class=\"btn btn-link\" data-skcomponent=\"skbutton\" data-skbuttontype=\"next-event\" \n              data-skform=\"otpForm\" data-skbuttonvalue=\"RESEND\"\u003e\n                  Resend verification code\n              \u003c/button\u003e   \n          \u003c/div\u003e\n        \u003c/form\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"
              },
              "customScript" : {
                "value" : "const focusOnFirstInputElement = () =\u003e {\r\n  document.getElementById(\"verificationCode\").focus();\r\n};\r\n\r\nconst handleVerifyBtn = () =\u003e {\r\n   const verificationCode = document.getElementById(\"verificationCode\");\r\n\r\n   if (window.addEventListener) {\r\n      // Normal browsers\r\n      verificationCode.addEventListener(\"keyup\", inputChanged, false);\r\n   } else if (window.attachEvent) {\r\n      // IE\r\n      verificationCode.attachEvent(\"keyup\", inputChanged);\r\n   }\r\n\r\n   function checkInputValid(val) {\r\n      return /^[a-z0-9_.-]{8}$/.test(val);\r\n   }\r\n\r\n   function inputChanged() {\r\n      let verifyButton = document.getElementById('verifyBtn');\r\n      if (!checkInputValid(verificationCode.value)) {\r\n         verifyButton.setAttribute(\"disabled\", \"true\");\r\n      } else {\r\n         verifyButton.removeAttribute(\"disabled\");\r\n      }\r\n   }\r\n\r\n   inputChanged();\r\n};\r\n\r\n/**\r\n * If page isn't loaded yet, wait for the page to load, then focus on first\r\n * input element.\r\n */\r\nif (document.readyState === \"loading\") {\r\n  // Loading hasn't finished yet\r\n  document.onreadystatechange = () =\u003e {\r\n    if (document.readyState === \"complete\") {\r\n      focusOnFirstInputElement(); \r\n      // handleVerifyBtn();\r\n    }\r\n  };\r\n} else {\r\n  // `DOMContentLoaded` has already fired\r\n  focusOnFirstInputElement(); \r\n//   handleVerifyBtn();\r\n}"
