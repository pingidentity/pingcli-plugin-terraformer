              "customScript" : {
                "value" : "const setFieldFocus = (id) =\u003e {\n    const element = document.getElementById(id);\n    if (element) {\n        element.focus();\n    }\n}\n\nif('{{agreementEnabled}}'){\n    let submitBtn = document.getElementById(\"btnRegister\");\n    submitBtn.setAttribute(\"disabled\", \"true\");\n    document.getElementById(\"agreeCheckBox\").addEventListener(\"click\", function(){\n        if (document.getElementById(\"agreeCheckBox\").checked == true) {\n            submitBtn.removeAttribute(\"disabled\");\n        } else {\n            submitBtn.setAttribute(\"disabled\", \"true\");\n        }\n    });\n}\n\nconst fetchCSS = () =\u003e {\n    return fetch('https://assets.pingone.com/ux/end-user-nano/0.1.0-alpha.1/end-user-nano.css')\n        .then(response =\u003e response.text())\n        .catch(error =\u003e {\n            console.error('Error fetching CSS:', error);\n        });\n};\n\nconst generatePopupHTML = (title, agreementText, logoUrl, logoStyle, companyName, cssContent) =\u003e {\n    return `\n    \u003chtml\u003e\n    \u003ctitle\u003e$${title}\u003c/title\u003e\n    \u003chead\u003e\n        \u003clink rel=\"icon\" href=\"https://library.pingidentity.com/images/ping-favicon.png\" /\u003e\n        \u003cstyle\u003e\n            $${cssContent}\n        \u003c/style\u003e\n    \u003c/head\u003e\n    \u003cbody\u003e\n        \u003cdiv class=\"end-user-nano\"\u003e\n            \u003cdiv class=\"bg-light d-flex flex-column justify-content-center align-items-center position-absolute top-0 start-0 bottom-0 end-0 overflow-auto\"\u003e\n                \u003cdiv style=\"max-width: 500px; min-width: 500px; width: 100%; overflow-y: auto; overflow-x: none\"\u003e\n                    \u003cdiv class=\"card shadow mb-5\"\u003e\n                        \u003cdiv class=\"card-body p-5 d-flex flex-column\"\u003e\n                            \u003cimg class=\"align-self-center mb-5\" src=\"$${logoUrl}\" style=\"$${logoStyle}\" alt=\"$${companyName}\" /\u003e\n                            \u003ch1 class=\"text-center mb-4\"\u003e$${title}\u003c/h1\u003e\n                            \u003cdiv style=\"white-space: pre-line;\"\u003e\n                            $${agreementText}\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/body\u003e\n    \u003c/html\u003e`;\n};\n\nconst popupToS = (cssContent) =\u003e {\n    const newWindow = window.open('', '_companyToS');\n    if (!newWindow) {\n        console.error(\"Failed to open the window\");\n        return;\n    }\n\n    const agreementText = `{{agreementText}}`;\n    const title = `{{agreementTitle}}`;\n    const logoUrl = `{{logoUrl}}`;\n    const logoStyle = `{{logoStyle}}`;\n    const companyName = `{{companyName}}`;\n\n    const htmlToWrite = generatePopupHTML(title, agreementText, logoUrl, logoStyle, companyName, cssContent);\n\n    newWindow.document.write(htmlToWrite);\n    newWindow.document.close();\n};\n\nconst start = async () =\u003e {\n    setFieldFocus(\"email\");\n    const tosButton = document.getElementById(\"tosBtn\");\n    if (tosButton) {\n        const cssContent = await fetchCSS();\n        if (tosButton.addEventListener) {\n            tosButton.addEventListener(\"click\", () =\u003e popupToS(cssContent));\n        } else if (tosButton.attachEvent) {\n            tosButton.attachEvent(\"onclick\", () =\u003e popupToS(cssContent));\n        } else {\n            tosButton.onclick = () =\u003e popupToS(cssContent);\n        }\n    }  \n}\n\nif (document.readyState === \"loading\") {\n    // Loading hasn't finished yet\n    document.addEventListener(\"DOMContentLoaded\", start);\n} else {\n    // `DOMContentLoaded` has already fired\n    start();\n}\n"
