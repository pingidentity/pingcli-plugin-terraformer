           \u003cspan class=\"text-left-to-icon\"\u003eAuthenticator App\u003c/span\u003e\n                    {{/ifEquals}}\n                    {{#ifEquals type \"MOBILE\"}}\n                    \u003ci class=\"mdi mdi-cellphone text-dark fs-1\" aria-hidden=\"true\"\u003e\u003c/i\u003e\n                    \u003cspan class=\"text-left-to-icon\"\u003e{{applicationName}}\u003c/span\u003e\n                    {{/ifEquals}}\n                \u003c/h1\u003e\n                \u003cp class=\"text-muted text-center\"\u003e\n                    {{#if isMobileTOTPDevice}}\n                        Enter the passcode displayed in the app.\n                    {{else}}\n                        {{#ifEquals type \"SMS\"}}\n                            Enter the passcode you received in the text messsage.\n                        {{/ifEquals}}\n                        {{#ifEquals type \"EMAIL\"}}\n                            Enter the passcode you received.\n                        {{/ifEquals}}\n                        {{#ifEquals type \"VOICE\"}}\n                            Enter the passcode you heard.\n                        {{/ifEquals}}\n                    {{/if}}\n                \u003c/p\u003e\n                \u003cdiv id=\"error-wrap\"\u003e\n                    \u003cp class=\"text-danger mdi mdi-alert-circle text-center\" data-id=\"feedback\" data-skcomponent=\"skerror\"\n                        id=\"error-msg\"\u003e\u003c/p\u003e\n                \u003c/div\u003e\n                \u003cp class=\"text-danger mdi mdi-alert-circle text-center\" data-skerrorid=\"passcode\" data-skcomponent=\"skerrormessage\"\u003e\u003c/p\u003e\n                \u003cform id=\"otp-form\" data-id=\"otp-form\"\u003e\n                    \u003cdiv class=\"mb-4 form-floating\"\u003e\n                        \u003cinput class=\"form-control text-center\" id=\"passcode\" type=\"text\" autocomplete=\"on\" maxlength=\"6\" /\u003e\n                    \u003c/div\u003e\n                    \u003cp class=\"text-muted text-center\" id=\"contact\"\u003e\n                        {{#ifEquals type \"SMS\"}}\n                            \u003cp class=\"text-muted text-center mb-4 mt-4\"\"\u003eMessage sent to:\u003c/p\u003e\n                            \u003cp class=\"text-muted text-center\"\u003e{{phone}}\u003c/p\u003e\n                        {{/ifEquals}}\n                        {{#ifEquals type \"EMAIL\"}}\n                            \u003cp class=\"text-muted text-center mb-4 mt-4\"\u003eEmail sent to:\u003c/p\u003e\n                            \u003cp class=\"text-muted text-center\"\u003e{{email}}\u003c/p\u003e\n                        {{/ifEquals}}\n                        {{#ifEquals type \"VOICE\"}}\n                            \u003cp class=\"text-muted text-center mb-4 mt-4\"\u003eCalling:\u003c/p\u003e\n                            \u003cp class=\"text-muted text-center\"\u003e{{phone}}\u003c/p\u003e\n                        {{/ifEquals}}\n                        {{#ifEquals type \"MOBILE\"}}\n                            \u003cp class=\"text-muted text-center mb-4 mt-4\"\u003eAuthenticator sent to:\u003c/p\u003e\n                            \u003cp class=\"text-muted text-center\"\u003e{{deviceName}}\u003c/p\u003e\n                        {{/ifEquals}}\n                    \u003c/p\u003e\n                    \u003cdiv class=\"d-flex flex-column mt-5\"\u003e\n                        {{#unless isMobileTOTPDevice}}\n                        \u003cbutton id=\"resend\" type=\"button\" class=\"btn btn-link\" data-skcomponent=\"skbutton\"\n                            data-skbuttontype=\"next-event\" data-skbuttonvalue=\"resend\"\u003e\n                            {{#ifEquals type \"VOICE\"}}\n                                Call Again\n                            {{else}}\n                                Resend passcode\n                            {{/ifEquals}}\n                        \u003c/button\u003e\n                        {{/unless}}\n                        \u003cbutton id=\"submit\" type=\"submit\" class=\"btn btn-primary mb-3\" data-skcomponent=\"skbutton\"\n                            data-skbuttontype=\"form-submit\" data-skform=\"otp-form\" data-skbuttonvalue=\"submit\"\u003e\n                            Finish\n                        \u003c/button\u003e\n                        {{#if canChangeDevice}}\n                        \u003cbutton id=\"differentMethod\" type=\"button\" class=\"btn btn-link\" data-skcomponent=\"skbutton\"\n                            data-skbuttontype=\"next-event\" data-skform=\"otp-form\" data-skbuttonvalue=\"differentMethod\"\u003e\n                            Cancel\n                        \u003c/button\u003e\n                        {{/if}}\n                    \u003c/div\u003e\n                \u003c/form\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e"
              },
              "customScript" : {
                "value" : "const passcode = document.getElementById(\"passcode\");\npasscode.focus();\nconst errorDiv = document.getElementById('error-wrap');\n\nif (errorDiv) {\n  const observer = new MutationObserver((mutations) =\u003e {\n    mutations.forEach((mutation) =\u003e {\n      if (mutation.type === 'childList' || mutation.type === 'subtree') {\n        contentChanged();\n      }\n    });\n  });\n\n  observer.observe(errorDiv, {\n    childList: true,\n    subtree: true\n  });\n}\n passcode.addEventListener('keyup', inputChanged, false);\n\nfunction contentChanged() {\n   let errorMsg = document.getElementById('error-msg');\n   if (errorMsg) {\n      // // Add a class that defines an animation\n      // passcode.classList.add('error');\n      // passcode.style.border = \"2px solid #a31300\";\n      \n      // // remove the class after the animation completes\n      // setTimeout(function() {\n      //       passcode.classList.remove('error');\n      // }, 300);\n\n      errorDiv.classList.add(\"feedback\");\n      if (errorMsg.innerText === \"OTP Resent\") {\n         errorMsg.classList.add(\"feedback--alert\");\n         errorMsg.classList.add(\"picon-alert\");\n         errorMsg.classList.remove(\"feedback--error\");\n         errorMsg.classList.remove(\"picon-error\");\n      } else {\n         errorMsg.classList.remove(\"feedback--alert\");\n         errorMsg.classList.remove(\"picon-alert\");\n         errorMsg.classList.add(\"feedback--error\");\n         errorMsg.classList.add(\"picon-error\");\n      }\n   } else {\n      errorDiv.classList.remove(\"feedback\");\n   }\n}\n\n// function checkInputValid(val) {\n//    return /^[0-9]{6}$/.test(val);\n// }\n\n// function inputChanged() {\n//    let submitButton = document.getElementById('submit');\n//    if (checkInputValid(passcode.value)) {\n//       submitButton.click();\n//    }\n// }\n"
