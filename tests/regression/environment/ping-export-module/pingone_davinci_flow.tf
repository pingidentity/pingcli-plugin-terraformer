Enabled\"] = selectValue(params.flowParameters.isGoogleEnabled, params.ciam_googleEnabled);\n\n\tresults[\"flowSocialRegistrationEnabled\"] = results[\"flowAppleEnabled\"] || results[\"flowFacebookEnabled\"] || results[\"flowGoogleEnabled\"];\n\n\treturn { ...results };\n}"
